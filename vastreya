  }catch(err){T(err.message||'Test payment failed');const area=q('#sfcobody .sf-comain');if(area){let line=area.querySelector('.sf-test-error');if(!line){line=document.createElement('p');line.className='sf-test-error';line.setAttribute('role','alert');line.style.color='#a32929';area.appendChild(line)}line.textContent=err.message||'Test payment failed';}btn.disabled=false;btn.textContent='Pay (Test Mode)';}
