<!doctype html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Vastréya · Indian Fashion</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,500&family=Inter:wght@400;500;600;700&display=swap">
<style>
:root{box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);
--bg:#f6f3ee;--card:#fff;--ink:#1c2420;--mut:#6f7771;--line:#ece7de;--green:#3f7a63;--peach:#eea58f;--gold:#e0a93c;--blue:#4f86d6;--lilac:#b7a3cf;--side:#0f2a22;--chip:#f4f1ea;
--serif:'Playfair Display',Georgia,serif;--sans:'Inter',system-ui,sans-serif}
@media(prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#121a17;--card:#1a2420;--ink:#eef2ee;--mut:#9aa69f;--line:#2a3631;--chip:#232f2a;--side:#08130f}}
:root[data-theme="dark"]{--bg:#121a17;--card:#1a2420;--ink:#eef2ee;--mut:#9aa69f;--line:#2a3631;--chip:#232f2a;--side:#08130f}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:14px/1.45 var(--sans)}
h1,h2,h3{font-family:var(--serif);margin:0}
.app{display:grid;grid-template-columns:244px 1fr;min-height:100vh}
aside{background:linear-gradient(180deg,var(--side),#173b2f 70%,#2b2418);color:#d9e3dd;padding:26px 14px;position:sticky;top:0;height:100vh;display:flex;flex-direction:column;overflow:auto}
.logo{font:italic 600 40px var(--serif);color:#fff;text-align:center;line-height:1}.logo small{display:block;font:500 8px var(--sans);letter-spacing:.3em;margin-top:6px;color:#b9c9c0;font-style:normal}
nav{margin-top:28px}nav a{display:flex;align-items:center;gap:14px;padding:11px 14px;border-radius:10px;color:#d9e3dd;text-decoration:none;font-weight:500;margin:2px 0;cursor:pointer}
nav a i{font-style:normal;width:20px;text-align:center;opacity:.9}nav a:hover{background:rgba(255,255,255,.07)}nav a.on{background:rgba(255,255,255,.12);box-shadow:inset 3px 0 0 var(--gold);color:#fff}
nav .sub a{padding:7px 14px 7px 48px;font-size:13px;color:#aebdb5}
.tag{margin-top:auto;padding:30px 10px 4px;font:500 24px/1.15 var(--serif);color:#fff}.tag small{display:block;margin-top:12px;font:500 10px var(--sans);letter-spacing:.3em;color:#cfd9d3}
main{padding:14px 26px 30px;min-width:0;overflow-x:hidden}
.top{display:flex;align-items:center;gap:14px;margin-bottom:14px}
.top input{flex:1;max-width:480px;padding:11px 14px;border:1px solid var(--line);border-radius:10px;background:var(--card);color:var(--ink);font:inherit}
.sp{flex:1}.pill{display:flex;background:var(--card);border:1px solid var(--line);border-radius:99px;padding:3px}.pill button{border:0;background:none;width:34px;height:30px;border-radius:99px;cursor:pointer;font-size:15px;color:var(--ink)}.pill button.on{background:var(--chip)}
.bell{position:relative;width:42px;height:42px;border-radius:12px;border:1px solid var(--line);background:var(--card);display:grid;place-items:center}.bell b{position:absolute;top:-5px;right:-5px;background:#d6453d;color:#fff;font-size:10px;border-radius:99px;padding:1px 6px}
.me{display:flex;align-items:center;gap:10px}.av{width:38px;height:38px;border-radius:50%;background:var(--side);color:#fff;display:grid;place-items:center;font-weight:600}.me small{display:block;color:var(--mut);font-size:11px;line-height:1.1}
.wel{display:flex;justify-content:space-between;align-items:end;margin:14px 0 14px}.wel h1{font-size:32px}.wel p{margin:2px 0 0;color:var(--mut)}
.date{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:9px 14px;font-size:13px}
.row1{display:grid;grid-template-columns:repeat(4,1fr) 1.15fr;gap:14px}
.kpi{border-radius:16px;padding:18px;display:flex;flex-direction:column;gap:10px;position:relative;overflow:hidden;color:#1c2420}
.kpi .h{display:flex;gap:14px;align-items:center}.ic{width:54px;height:54px;border-radius:50%;display:grid;place-items:center;font-size:24px;background:rgba(255,255,255,.65)}
.kpi small{font-size:13px}.kpi strong{display:block;font:700 26px var(--serif)}.up{color:#17803d;font-weight:700;font-size:12px}.kpi em{display:block;font-style:normal;color:#6f7771;font-size:11px}
.kpi svg{position:absolute;right:10px;bottom:14px;width:46%;height:46px}
.k1{background:#e5ece3}.k2{background:#f8dfd5}.k3{background:#dde8f6}.k4{background:#f8ecd2}
.ban{grid-row:span 2;border-radius:16px;padding:22px;color:#fff;display:flex;flex-direction:column;justify-content:flex-end;min-height:230px;background:radial-gradient(circle at 75% 25%,rgba(224,169,60,.55),transparent 45%),linear-gradient(150deg,#6b4a2a,#2b3d2d 60%,#173b2f)}
.ban .logo{text-align:left;font-size:34px}.ban h3{font:500 22px/1.2 var(--serif);margin:56px 0 8px}.ban span{font-size:11px;letter-spacing:.12em}
.card{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:18px 20px}
.card h3{font-size:19px;margin-bottom:12px}.cardh{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap}.cardh a{font-size:12px;color:var(--ink);text-decoration:none;font-weight:600;cursor:pointer}
.grid2{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(0,1fr) minmax(0,1fr);gap:14px;margin-top:14px}.s2{grid-column:span 2}
.leg{display:flex;gap:14px;font-size:12px;color:var(--mut)}.leg i{display:inline-block;width:10px;height:10px;border-radius:3px;margin-right:5px}
.chart{width:100%;height:auto;display:block}.chart text{fill:var(--mut);font-size:10px}
.donut{display:flex;gap:18px;align-items:center;flex-wrap:wrap}.donut svg{width:170px;flex:none}.dl{flex:1;min-width:150px}.dl div{display:flex;justify-content:space-between;padding:6px 0;font-size:13px}.dl i{display:inline-block;width:10px;height:10px;border-radius:3px;margin-right:8px}
select{border:1px solid var(--line);background:var(--card);color:var(--ink);border-radius:8px;padding:8px 12px;font:inherit}
.qa{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;text-align:center;font-size:12px;font-weight:500}.qa div{cursor:pointer}.qa b{display:grid;place-items:center;width:100%;aspect-ratio:1;max-width:60px;margin:0 auto 8px;border-radius:14px;font-size:22px;font-weight:400;transition:.2s}.qa div:hover b{transform:translateY(-3px)}
.mk{display:grid;grid-template-columns:repeat(3,1fr) .6fr;gap:12px;margin-top:6px}
.m{border-radius:14px;padding:14px}.m .t{display:flex;align-items:center;gap:10px}.lg{width:38px;height:38px;border-radius:10px;display:grid;place-items:center;color:#fff;font-weight:800;font-size:18px}
.m .t b{display:block}.m .t small{color:#666}.con{margin-left:auto;font-size:10px;background:#fff;color:#17803d;padding:3px 8px;border-radius:99px;font-weight:600}
.th{display:flex;gap:8px;margin:12px 0}.th i{width:44px;height:44px;border-radius:8px;display:block}
.sy{display:flex;justify-content:space-between;align-items:center;gap:6px;font-size:11px;color:#555}.sy button{background:#fff;border:1px solid #ddd;border-radius:8px;padding:7px 10px;font:600 12px var(--sans);cursor:pointer}
.add{border:1.5px dashed var(--line);border-radius:14px;display:grid;place-items:center;text-align:center;color:var(--mut);font-size:12px;padding:10px;cursor:pointer}.add b{display:block;font-size:26px;font-weight:400}
.grid3{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(0,1fr) minmax(0,1fr);gap:14px;margin-top:14px}
table{width:100%;border-collapse:collapse}th{font-size:10px;letter-spacing:.07em;text-transform:uppercase;color:var(--mut);text-align:left;padding:8px 6px;background:var(--chip)}td{padding:9px 6px;border-bottom:1px solid var(--line);font-size:12px}
.u{display:flex;align-items:center;gap:8px}.u i{width:24px;height:24px;border-radius:50%;display:grid;place-items:center;font-size:10px;font-style:normal;color:#fff;font-weight:700;flex:none}
.st{padding:3px 10px;border-radius:99px;font-size:11px;font-weight:600}.Processing{background:#dbe8f8;color:#2b5fa5}.Shipped{background:#dcf0e0;color:#17803d}.Delivered{background:#d6f0e8;color:#0d6b52}
.v{background:var(--chip);border:0;border-radius:7px;padding:5px 10px;cursor:pointer;color:var(--ink);font:inherit;font-size:11px}
.p{width:30px;height:34px;border-radius:6px;flex:none}.lo{display:inline-block;min-width:26px;text-align:center;border-radius:6px;padding:3px 7px;font-weight:700}
.tw{overflow-x:auto}
@media(max-width:1200px){.grid2,.grid3{grid-template-columns:minmax(0,1fr)}.row1{grid-template-columns:repeat(2,1fr)}.ban{grid-row:auto;grid-column:span 2}.grid2,.grid3{grid-template-columns:1fr}.s2{grid-column:auto}}
@media(max-width:820px){.app{grid-template-columns:1fr}aside{position:static;height:auto}.tag{display:none}main{padding:12px}.mk{grid-template-columns:1fr}.row1{grid-template-columns:1fr}.ban{grid-column:auto}.wel{flex-direction:column;align-items:start;gap:10px}.me div{display:none}}

.m{color:#1c2420}.m .t small,.sy{color:#555}.sy button{color:#1c2420}.sy button:disabled{opacity:.6}
td{white-space:nowrap}.v:hover,.sy button:hover{filter:brightness(.95)}nav a,.qa div,.add,.bell,.date{user-select:none}
.toast{position:fixed;left:50%;bottom:calc(22px + env(safe-area-inset-bottom,0px));transform:translate(-50%,20px);background:#1c2420;color:#fff;padding:11px 18px;border-radius:12px;opacity:0;pointer-events:none;transition:.25s;z-index:99;font-size:13px}.toast.on{opacity:1;transform:translate(-50%,0)}
.mod{position:fixed;inset:0;background:rgba(0,0,0,.45);display:none;align-items:center;justify-content:center;padding:20px;z-index:90}.mod.on{display:flex}.mod>div{background:var(--card);color:var(--ink);border-radius:18px;padding:24px;max-width:420px;width:100%}.mod h3{margin-bottom:10px}.mod p{margin:6px 0;color:var(--mut)}.mod p b{color:var(--ink)}.mod button{margin-top:14px;padding:9px 18px;border:0;border-radius:99px;background:var(--side);color:#fff;cursor:pointer;font:inherit}
@keyframes spin{to{transform:rotate(360deg)}}.spin{display:inline-block;animation:spin .8s linear infinite}

/* ---- Storefront (added) ---- */
:root{--t1:#e5ece3;--t2:#f8dfd5;--t3:#dde8f6;--t4:#f8ecd2}
@media(prefers-color-scheme:dark){:root:not([data-theme="light"]){--t1:#1f3128;--t2:#3a2a24;--t3:#1f2c3b;--t4:#373021}}
:root[data-theme="dark"]{--t1:#1f3128;--t2:#3a2a24;--t3:#1f2c3b;--t4:#373021}
.sf-tabs{display:flex;gap:6px;flex-wrap:wrap}.sf-tabs button,.sf-chips button{border:1px solid var(--line);background:var(--card);color:var(--ink);border-radius:99px;padding:7px 15px;font:500 13px var(--sans);cursor:pointer}
.sf-tabs button.on,.sf-chips button.on{background:var(--side);border-color:var(--side);color:#fff}.sf-tabs button[data-soon]{color:var(--mut);border-style:dashed}
.sf-site{background:var(--card);border:1px solid var(--line);border-radius:18px;overflow:hidden}
.sf-hd{display:flex;align-items:center;gap:20px;padding:14px 24px;border-bottom:1px solid var(--line);flex-wrap:wrap}
.sf-hd .logo{color:var(--ink);font-size:30px;text-align:left}.sf-hd .logo small{color:var(--mut);margin-top:3px}
.sf-links{display:flex;gap:20px;font-weight:500;flex:1}.sf-links a{cursor:pointer;padding:4px 0;border-bottom:2px solid transparent}.sf-links a:hover{border-color:var(--peach)}
.sf-cart{position:relative;border:1px solid var(--line);background:var(--card);color:var(--ink);border-radius:12px;padding:9px 16px;font:600 13px var(--sans);cursor:pointer}
.sf-cart b{background:var(--peach);color:#1c2420;border-radius:99px;padding:1px 8px;margin-left:6px}
.sf-cartback{position:fixed;inset:0;background:rgba(17,28,22,.48);opacity:0;pointer-events:none;transition:.22s;z-index:120}
.sf-cartback.on{opacity:1;pointer-events:auto}
.sf-cartpanel{position:fixed;top:0;right:0;width:min(430px,100vw);height:100dvh;background:var(--card);color:var(--ink);z-index:121;transform:translateX(102%);transition:transform .26s ease;box-shadow:-24px 0 60px rgba(0,0,0,.18);display:flex;flex-direction:column}
.sf-cartpanel.on{transform:translateX(0)}
.sf-carthead{display:flex;align-items:center;justify-content:space-between;padding:20px 22px;border-bottom:1px solid var(--line)}
.sf-carthead h3{margin:0;font:600 26px var(--serif)}
.sf-cartclose{width:38px;height:38px;border:1px solid var(--line);background:var(--chip);color:var(--ink);border-radius:50%;font-size:22px;cursor:pointer}
.sf-cartbody{padding:14px 22px;overflow:auto;flex:1}
.sf-empty{min-height:55vh;display:grid;place-items:center;text-align:center;color:var(--mut)}.sf-empty b{display:block;color:var(--ink);font:600 23px var(--serif);margin-bottom:6px}
.sf-ci{display:grid;grid-template-columns:72px 1fr auto;gap:12px;padding:14px 0;border-bottom:1px solid var(--line);align-items:center}.sf-ci:last-child{border-bottom:0}
.sf-ci-pic{width:72px;height:82px;border-radius:12px;display:grid;place-items:center}.sf-ci-pic svg{width:58%;fill:var(--side);opacity:.82}
.sf-ci h4{margin:0 0 4px;font:600 17px var(--serif)}.sf-ci small{color:var(--mut)}.sf-ci-price{font-weight:700;margin-top:7px}
.sf-qty{display:flex;align-items:center;gap:9px;margin-top:9px}.sf-qty button{width:28px;height:28px;border:1px solid var(--line);border-radius:8px;background:var(--chip);color:var(--ink);cursor:pointer}.sf-qty b{min-width:18px;text-align:center}
.sf-remove{border:0;background:none;color:#b3402f;cursor:pointer;font:600 12px var(--sans);padding:5px}
.sf-cartfoot{border-top:1px solid var(--line);padding:18px 22px 22px;background:var(--card)}.sf-total{display:flex;justify-content:space-between;align-items:end;margin-bottom:14px}.sf-total span{color:var(--mut)}.sf-total strong{font:700 27px var(--serif)}
.sf-checkout{width:100%;border:0;border-radius:12px;padding:13px 18px;background:var(--side);color:#fff;font:700 14px var(--sans);cursor:pointer}.sf-checkout:disabled{opacity:.45;cursor:not-allowed}.sf-cartnote{text-align:center;color:var(--mut);font-size:11px;margin:9px 0 0}
body.sf-cart-open{overflow:hidden}
.sf-checkoutback{position:fixed;inset:0;background:rgba(10,22,17,.62);backdrop-filter:blur(7px);opacity:0;pointer-events:none;transition:.22s;z-index:130;padding:24px;overflow:auto}
.sf-checkoutback.on{opacity:1;pointer-events:auto}
.sf-checkoutbox{width:min(980px,100%);margin:3vh auto;background:var(--card);color:var(--ink);border:1px solid var(--line);border-radius:22px;box-shadow:0 28px 80px rgba(0,0,0,.28);overflow:hidden}
.sf-cohead{display:flex;align-items:center;justify-content:space-between;gap:18px;padding:20px 24px;border-bottom:1px solid var(--line)}
.sf-cohead h3{font:600 28px var(--serif);margin:0}.sf-cohead p{margin:3px 0 0;color:var(--mut);font-size:12px}.sf-coclose{width:40px;height:40px;border:1px solid var(--line);background:var(--chip);color:var(--ink);border-radius:50%;font-size:23px;cursor:pointer}
.sf-steps{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;padding:16px 24px 0}.sf-step{display:flex;gap:9px;align-items:center;color:var(--mut);font-size:12px}.sf-step i{width:28px;height:28px;border-radius:50%;display:grid;place-items:center;background:var(--chip);font-style:normal;font-weight:700}.sf-step.on{color:var(--ink);font-weight:700}.sf-step.on i,.sf-step.done i{background:var(--side);color:#fff}.sf-step.done{color:var(--green)}
.sf-cogrid{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(280px,.75fr);gap:0;min-height:520px}.sf-comain{padding:24px}.sf-coside{padding:24px;background:var(--chip);border-left:1px solid var(--line)}
.sf-cotitle{font:600 22px var(--serif);margin:0 0 5px}.sf-cosub{margin:0 0 20px;color:var(--mut);font-size:12px}.sf-formgrid{display:grid;grid-template-columns:1fr 1fr;gap:13px}.sf-field{display:flex;flex-direction:column;gap:6px}.sf-field.full{grid-column:1/-1}.sf-field label{font-weight:700;font-size:12px}.sf-field input,.sf-field textarea,.sf-field select{width:100%;border:1px solid var(--line);background:var(--card);color:var(--ink);border-radius:11px;padding:12px 13px;font:500 13px var(--sans);outline:none}.sf-field textarea{min-height:88px;resize:vertical}.sf-field input:focus,.sf-field textarea:focus,.sf-field select:focus{border-color:var(--green);box-shadow:0 0 0 3px rgba(63,122,99,.12)}.sf-err{color:#b3402f;font-size:11px;min-height:14px}
.sf-coactions{display:flex;justify-content:space-between;gap:10px;margin-top:22px}.sf-cobtn{border:0;border-radius:11px;padding:12px 18px;font:700 13px var(--sans);cursor:pointer}.sf-cobtn.primary{background:var(--side);color:#fff}.sf-cobtn.ghost{background:var(--chip);color:var(--ink);border:1px solid var(--line)}.sf-cobtn:disabled{opacity:.45;cursor:not-allowed}
.sf-payopt{display:flex;align-items:flex-start;gap:12px;padding:14px;border:1px solid var(--line);border-radius:12px;margin:10px 0;cursor:pointer}.sf-payopt:has(input:checked){border-color:var(--green);box-shadow:0 0 0 3px rgba(63,122,99,.1)}.sf-payopt input{margin-top:3px}.sf-payopt b{display:block;margin-bottom:3px}.sf-payopt small{color:var(--mut)}.sf-demo{margin-top:14px;padding:12px 14px;border-radius:10px;background:rgba(224,169,60,.12);border:1px solid rgba(224,169,60,.28);font-size:11px;color:var(--mut)}
.sf-sumrow{display:flex;justify-content:space-between;gap:12px;padding:8px 0;font-size:12px}.sf-sumrow.total{border-top:1px solid var(--line);margin-top:8px;padding-top:14px;font-size:15px}.sf-sumrow.total strong{font:700 23px var(--serif)}.sf-coitems{margin-bottom:12px}.sf-coitem{display:grid;grid-template-columns:42px 1fr auto;gap:9px;align-items:center;padding:8px 0;border-bottom:1px solid var(--line)}.sf-coitem:last-child{border-bottom:0}.sf-coitem .pic{width:42px;height:48px;border-radius:8px;display:grid;place-items:center}.sf-coitem svg{width:54%;fill:var(--side)}.sf-coitem b{font-size:12px}.sf-coitem small{display:block;color:var(--mut);font-size:10px}.sf-reviewcard{border:1px solid var(--line);border-radius:13px;padding:14px;margin-bottom:13px}.sf-reviewcard h4{font:600 17px var(--serif);margin:0 0 7px}.sf-reviewcard p{margin:3px 0;color:var(--mut);font-size:12px;line-height:1.55}
.sf-success{text-align:center;padding:52px 24px}.sf-success .ok{width:72px;height:72px;border-radius:50%;margin:0 auto 18px;display:grid;place-items:center;background:rgba(63,122,99,.14);color:var(--green);font-size:34px}.sf-success h3{font:600 34px var(--serif);margin:0 0 8px}.sf-success p{color:var(--mut);margin:5px 0}.sf-success .orderno{display:inline-block;margin:18px 0;padding:10px 16px;border-radius:99px;background:var(--chip);font-weight:800;letter-spacing:.05em}
body.sf-checkout-open{overflow:hidden}
@media(max-width:760px){.sf-checkoutback{padding:0}.sf-checkoutbox{min-height:100dvh;margin:0;border-radius:0}.sf-cogrid{grid-template-columns:1fr}.sf-coside{border-left:0;border-top:1px solid var(--line)}.sf-formgrid{grid-template-columns:1fr}.sf-field.full{grid-column:auto}.sf-steps{padding-inline:16px}.sf-step span{display:none}.sf-comain,.sf-coside{padding:18px}.sf-cohead{padding:17px 18px}}
.sf-in{padding:22px 24px 28px}
.sf-hero{display:grid;grid-template-columns:1.1fr 1fr;gap:14px}
.sf-ban{border-radius:16px;padding:clamp(24px,4vw,48px);color:#fff;min-height:340px;display:flex;flex-direction:column;justify-content:flex-end;background:radial-gradient(circle at 78% 22%,rgba(224,169,60,.5),transparent 45%),linear-gradient(150deg,#6b4a2a,#2b3d2d 60%,#173b2f)}
.sf-ban h2{font:500 clamp(34px,4.6vw,58px)/1.05 var(--serif);margin:0 0 14px}.sf-ban p{margin:0 0 18px;max-width:40ch;color:#e3ebe5}
.sf-btn{display:inline-block;border:0;border-radius:10px;padding:11px 20px;font:600 13px var(--sans);cursor:pointer;background:var(--peach);color:#1c2420}.sf-btn:hover{filter:brightness(.95)}.sf-btn.d{background:var(--side);color:#fff}
.sf-ban .meta{margin-top:16px;font-size:11px;letter-spacing:.12em}
.sf-arches{border-radius:16px;background:var(--t1);display:flex;align-items:flex-end;justify-content:center;gap:12px;padding:0 20px;min-height:340px}
.sf-arch{width:31%;border-radius:140px 140px 0 0;display:grid;place-items:end center;padding-bottom:16px}.sf-arch svg{width:66%;fill:var(--side);opacity:.8}
