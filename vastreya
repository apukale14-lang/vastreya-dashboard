<script type="module">
let sb=null,currentUser=null;window.vastreyaGetToken=async()=>{const {data}=await sb.auth.getSession();return data.session?.access_token||''};
const $=s=>document.querySelector(s), status=(m,c='')=>{const e=$('#acctStatus');if(e){e.textContent=m;e.className='acct-status '+c}};
const openAcct=()=>{$('#acctBack')?.classList.add('on');$('#acctModal')?.classList.add('on');document.body.style.overflow='hidden'};
const closeAcct=()=>{$('#acctBack')?.classList.remove('on');$('#acctModal')?.classList.remove('on');document.body.style.overflow=''};
async function initAuth(){try{const r=await fetch('/api/auth-config',{cache:'no-store'}),cfg=await r.json();if(!cfg.url||!cfg.anonKey){status('Customer accounts are being connected. Shopping and cart are still available.');return}const mod=await import('https://esm.sh/@supabase/supabase-js@2');sb=mod.createClient(cfg.url,cfg.anonKey,{auth:{persistSession:true,autoRefreshToken:true,detectSessionInUrl:true}});const {data}=await sb.auth.getSession();currentUser=data.session?.user||null;syncUser();sb.auth.onAuthStateChange((_e,s)=>{currentUser=s?.user||null;syncUser()})}catch(e){status('Account service is temporarily unavailable.','err')}}
function syncUser(){const b=$('#custAccount');if(!b)return;if(currentUser){const name=currentUser.user_metadata?.full_name||currentUser.email||currentUser.phone||'Account';b.textContent=name.split('@')[0].slice(0,12);status('Signed in securely.','ok');closeAcct()}else b.textContent='Sign in'}
$('#custAccount')?.addEventListener('click',()=>{if(currentUser&&sb)window.vastreyaShowOrders?.();else openAcct()});$('#acctClose')?.addEventListener('click',closeAcct);$('#acctBack')?.addEventListener('click',closeAcct);
document.querySelectorAll('.acct-tabs button').forEach(b=>b.addEventListener('click',()=>{document.querySelectorAll('.acct-tabs button').forEach(x=>x.classList.toggle('on',x===b));$('#emailAuth').hidden=b.dataset.at!=='email';$('#phoneAuth').hidden=b.dataset.at!=='phone'}));
$('#authGoogle')?.addEventListener('click',async()=>{if(!sb)return status('Supabase project connection is still being finalized.','err');status('Opening Google sign in…');const {error}=await sb.auth.signInWithOAuth({provider:'google',options:{redirectTo:location.origin+'/'}});if(error)status(error.message,'err')});
$('#emailAuth')?.addEventListener('submit',async e=>{e.preventDefault();if(!sb)return status('Supabase project connection is still being finalized.','err');const email=$('#authEmail').value.trim(),password=$('#authPassword').value;status('Signing in…');let r=await sb.auth.signInWithPassword({email,password});if(r.error){r=await sb.auth.signUp({email,password});if(r.error)return status(r.error.message,'err');return status(r.data.session?'Account created and signed in.':'Check your email to confirm your new account.','ok')}status('Signed in.','ok')});
$('#phoneAuth')?.addEventListener('submit',async e=>{e.preventDefault();if(!sb)return status('Supabase project connection is still being finalized.','err');let phone=$('#authPhone').value.replace(/[\s()-]/g,'');if(/^\d{10}$/.test(phone))phone='+91'+phone;const password=$('#authPhonePassword').value;status('Signing in…');let r=await sb.auth.signInWithPassword({phone,password});if(r.error){r=await sb.auth.signUp({phone,password});if(r.error)return status(r.error.message,'err');return status(r.data.session?'Account created and signed in.':'A verification step may be required for this mobile number.','ok')}status('Signed in.','ok')});
// Protect checkout: customers may browse/cart anonymously, but must sign in before beginning checkout.
document.addEventListener('click',e=>{const btn=e.target.closest('#sfcheckout,[data-cart="checkout"]');if(btn&&!currentUser){e.preventDefault();e.stopImmediatePropagation();openAcct();status('Please sign in before checkout. Your bag is saved.');}},true);
$('#storeSearchBtn')?.addEventListener('click',()=>{$('#proSearchbar')?.classList.toggle('on');setTimeout(()=>$('#storeSearch')?.focus(),0)});$('#storeSearchClose')?.addEventListener('click',()=>$('#proSearchbar')?.classList.remove('on'));
$('#storeSearch')?.addEventListener('input',e=>{const term=e.target.value.trim().toLowerCase();document.querySelectorAll('.sf-pc').forEach(card=>{card.style.display=!term||card.textContent.toLowerCase().includes(term)?'flex':'none'})});
window.vastreyaShowOrders=async()=>{if(!currentUser){openAcct();return}let panel=document.querySelector('#vMyOrders');if(!panel){panel=document.createElement('div');panel.id='vMyOrders';panel.className='orders-overlay';panel.innerHTML='<div class="orders-panel"><header><div><small>VASTRÉYA ACCOUNT</small><h2>My orders</h2><p>Track your orders</p></div><button id="vMyOrdersClose" aria-label="Close">×</button></header><div id="vMyOrdersList">Loading…</div></div>';document.body.append(panel);panel.addEventListener('click',e=>{if(e.target===panel||e.target.closest('#vMyOrdersClose'))panel.classList.remove('on')})}panel.classList.add('on');const list=panel.querySelector('#vMyOrdersList');list.textContent='Loading orders…';try{const token=await window.vastreyaGetToken();const r=await fetch('/api/orders',{headers:{Authorization:'Bearer '+token}});const d=await r.json();if(!r.ok)throw Error(d.error||'Could not load orders');window.vastreyaCustomerOrders=d.orders||[];window.vastreyaCustomerReturns=d.returns||[];const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));list.innerHTML=d.orders.length?d.orders.map(o=>`<article class="order-tile"><div class="order-line"><b>${esc(o.order_number)}</b><span>${esc(o.status)}</span></div><p>${new Date(o.created_at).toLocaleDateString('en-IN')} · ₹${Number(o.total_rupees).toLocaleString('en-IN')} · ${esc(o.payment_method)}</p><div>${(o.items||[]).map(i=>`<div class="order-line small"><span>${esc(i.name)} × ${i.quantity}</span><b>₹${Number(i.line_total_rupees).toLocaleString('en-IN')}</b></div>`).join('')}</div><small>${o.demo_order?'Historical test order — not for dispatch':'Payment due on delivery'}</small>${(d.returns||[]).filter(rr=>rr.order_id===o.id).map(rr=>`<div class="v-return-history"><b>${esc(rr.id)}</b> · ${esc(rr.product_name)} — ${esc(rr.status)}${rr.refund_status==='refunded'?' · Refund recorded':''}</div>`).join('')}${!o.demo_order&&o.status==='delivered'?`<div class="order-action-row"><button type="button" class="v-return-request" data-vreturn="${esc(o.id)}">Request a return</button></div>`:''}${['pending','confirmed'].includes(o.status)?`<div class="order-action-row"><button class="order-cancel-btn" data-vcancel="${esc(o.id)}" data-vnumber="${esc(o.order_number)}">Cancel order</button></div>`:''}</article>`).join(''):'<p>No orders yet. Add something to your bag to begin.</p>'}catch(err){list.textContent=err.message||'Could not load orders'}};
initAuth();
</script><style>.order-action-row{margin-top:14px;display:flex;justify-content:flex-end}.order-cancel-btn{background:transparent;border:1px solid #c06d5e;color:#a54234;border-radius:9px;padding:9px 14px;font:600 12px Inter,system-ui;cursor:pointer}.order-cancel-btn:hover{background:#fff0eb}.order-cancel-btn:disabled{opacity:.5;cursor:wait}</style>
